{
  "name": "meshcommander",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "dev": "bun run --filter '*' dev",
    "console": "bun run --cwd apps/console dev",
    "mock": "bun run --cwd packages/mock dev",
    "site": "bun run --cwd apps/site dev",
    "cli": "bun run --cwd packages/build-system cli"
  }
}
