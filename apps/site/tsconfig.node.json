{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.site-node.tsbuildinfo",
    "target": "es2023",
    // Playwright callbacks run in the page, so the node-side project still needs
    // the DOM lib to type them.
    "lib": ["ES2023", "DOM"],
    "types": ["bun"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "preserve",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "scripts"]
}
